    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "auth": "1.6.27",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.10",
